# =========================================================================
# COLLABORATIVE TRIP PLANNER - SERVER ENVIRONMENT CONFIGURATION
# =========================================================================

# Port for Express & Socket.io Backend
PORT=5000

# PostgreSQL Connection String (Prisma ORM database URL)
# Replace user, password, host, port, and dbname with your own PostgreSQL details.
# Example for local PostgreSQL: postgresql://postgres:mypassword@localhost:5432/trip_planner?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trip_planner?schema=public"

# JWT Token secret for user session signing (change to a strong random string)
JWT_SECRET="super_secret_jwt_signkey_change_me_in_production"

# Cloudinary Credentials for free image and PDF document uploads.
# Get these from your Cloudinary dashboard: https://cloudinary.com/
# If these are left blank, the server runs in fail-safe fallback mode returning mock images.
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
